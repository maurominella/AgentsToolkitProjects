# This file includes environment variables that will be committed to git by default.

# Foundry configuration, requires FoundryAgentConsumer (better) or FoundryUser (uselessly wider) role
FOUNDRY_AGENT_ENDPOINT='https://foundry6345.services.ai.azure.com/api/projects/std-agent-project-6345/agents/prompt-agent01/endpoint/protocols/openai/responses'
FOUNDRY_API_VERSION='v1'

# Tenant of the app registration FOUNDRY_ENABLED_APP_ID (its secret goes in .env.dev.user)
FOUNDRY_ENABLED_APP_TENANT_ID='2ad3a46b-8573-43c1-8052-b9ebe982c2fe'

# Built-in environment variables
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev

# Updating AZURE_SUBSCRIPTION_ID or AZURE_RESOURCE_GROUP_NAME after provision may also require an update to RESOURCE_SUFFIX, because some services require a globally unique name across subscriptions/resource groups.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
RESOURCE_SUFFIX=

# Generated during provision, you can also add your own variables.
BOT_ID=
TEAMS_APP_ID=
BOT_AZURE_APP_SERVICE_RESOURCE_ID=
BOT_DOMAIN=
AGENT_SCOPE=shared