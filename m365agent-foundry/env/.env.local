# This file includes environment variables that can be committed to git. It's gitignored by default because it represents your local development environment.

# OpenAI configuration
AZURE_OPENAI_ENDPOINT='https://mmoaiswc-01.openai.azure.com/'
AZURE_OPENAI_DEPLOYMENT_NAME='gpt-5.4-mini'

# Foundry configuration, requires FoundryAgentConsumer (better) or FoundryUser (uselessly wider) role
FOUNDRY_AGENT_ENDPOINT='https://foundry6345.services.ai.azure.com/api/projects/std-agent-project-6345/agents/prompt-agent01/endpoint/protocols/openai/responses'
FOUNDRY_API_VERSION='v1'

# Tenant of the app registration FOUNDRY_ENABLED_APP_ID (its secret goes in .env.local.user)
FOUNDRY_ENABLED_APP_TENANT_ID='2ad3a46b-8573-43c1-8052-b9ebe982c2fe'

# Built-in environment variables
TEAMSFX_ENV=local
APP_NAME_SUFFIX=local

# Generated during provision, you can also add your own variables.
BOT_ID=
TEAMS_APP_ID=
BOT_DOMAIN=
BOT_ENDPOINT=